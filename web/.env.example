# PayPal sandbox app credentials [REQUIRES ACCOUNT] https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# CartHold is sandbox-only: it always calls api-m.sandbox.paypal.com. Leave SANDBOX (or unset); any other value
# (LIVE, PRODUCTION, ...) makes every PayPal call throw (src/lib/paypal/client.ts).
PAYPAL_ENVIRONMENT=SANDBOX
# Held orders: "paypal" (default) = the buyer approves each hold in PayPal; "card" = instant fallback to the sandbox
# test card if sandbox buyer approval breaks (src/lib/run/session.ts payerUrlsFor).
PAYPAL_HOLD_PAYER=
# Webhook id printed by scripts/paypal-webhook-register.mts (not a secret). Unset: /api/paypal/webhook answers 503.
PAYPAL_WEBHOOK_ID=
# Google AI Studio free-tier key [REQUIRES ACCOUNT] https://aistudio.google.com/apikey
# Used by the Live agent and by the injection inspector in both modes (regex fallback on error / 429).
GEMINI_API_KEY=

# Abuse limits (src/lib/run/limits.ts). Per-address caps are checked before the global caps.
# Live (Gemini agent + PayPal) runs allowed per UTC day across all users. Code default 60 (render.yaml sets 150).
LIVE_RUNS_PER_DAY=
# Simulated (scripted agent, Gemini inspector + PayPal sandbox) runs per UTC day across all users. Code default 200 (render.yaml sets 500).
SIMULATED_RUNS_PER_DAY=
# Live runs per client address per UTC day. Default 4.
LIVE_RUNS_PER_IP_DAY=
# Simulated runs per client address per UTC day. Default 15.
SIMULATED_RUNS_PER_IP_DAY=
# Header holding the real client IP, set by the proxy in front (e.g. true-client-ip behind Cloudflare). Wins over x-forwarded-for.
CLIENT_IP_HEADER=
# Fallback when CLIENT_IP_HEADER is absent: client IP = the x-forwarded-for entry this many hops from the right.
# Default 1 (Render's proxy only). Use 2 if a CDN such as Cloudflare sits in front of Render.
TRUSTED_PROXY_HOPS=
# Public URL of the deployed app, e.g. https://your-app.onrender.com (exact scheme + host, no trailing slash).
# When set, POST routes accept a browser Origin only if it equals this value, and the Host header is not trusted
# (src/lib/run/http.ts; test "Origin: when PUBLIC_ORIGIN is set" in src/lib/run/run.test.ts). Unset: Origin is
# compared with the Host header, which is fine locally. Set it on any public deploy.
PUBLIC_ORIGIN=
# Set to 1 in production: next start then leaves SIGTERM to src/instrumentation.ts, which voids held PayPal
# authorizations before exit.
NEXT_MANUAL_SIG_HANDLE=
